<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET -->

    <uses-permission
        android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NammaYantraShare"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NammaYantraShare">

        <!-- SPLASH -->

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN"/>

                <category
                    android:name="android.intent.category.LAUNCHER"/>

            </intent-filter>

        </activity>

        <!-- LOGIN -->

        <activity
            android:name=".LoginActivity"
            android:exported="false"/>

        <!-- REGISTER -->

        <activity
            android:name=".RegisterActivity"
            android:exported="false"/>

        <!-- DASHBOARD -->

        <activity
            android:name=".DashboardActivity"
            android:exported="false"/>

        <!-- ADD MACHINE -->

        <activity
            android:name=".AddMachineActivity"
            android:exported="false"/>

        <!-- VIEW MACHINES -->

        <activity
            android:name=".ViewMachinesActivity"
            android:exported="false"/>

        <!-- BOOKING -->

        <activity
            android:name=".BookingActivity"
            android:exported="false"/>

        <!-- OWNER REQUESTS -->

        <activity
            android:name=".OwnerRequestsActivity"
            android:exported="false"/>

        <!-- FARMER BOOKINGS -->

        <activity
            android:name=".FarmerBookingsActivity"
            android:exported="false"/>

        <!-- REVIEW -->

        <activity
            android:name=".ReviewActivity"
            android:exported="false"/>

        <!-- ADMIN -->

        <activity
            android:name=".admin.AdminDashboardActivity"
            android:exported="false"/>

    </application>

</manifest>